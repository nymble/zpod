# Shell fragment. Sourced by build.sh when writing a pi-gen config.
# Not a secret file. Placeholders stay empty until hardware is read off the board.

IMAGE_NAME=zpod
IMG_NAME=zpod
TARGET_HOSTNAME=zpod
ARCH=armhf
# pi0 or pi0w. Both are 32-bit. pi0w is the only one with onboard radio.
TARGET_BOARD=pi0
PI_GEN_REPO=https://github.com/RPi-Distro/pi-gen.git
PI_GEN_BRANCH=master
RELEASE=trixie
DEPLOY_COMPRESSION=xz
LOCALE_DEFAULT=en_US.UTF-8
KEYBOARD_KEYMAP=us
TIMEZONE_DEFAULT=America/Los_Angeles

# Zero W / Zero 2 W regulatory domain. build.sh defaults to US when empty for
# pi0w (needed so NetworkManager enables WLAN). Override here if needed.
# SSID/password are never stored in this repo — see docs/BOOT-WIFI.md.
WPA_COUNTRY=US

# Unknown until read from the board or the ZPOD user guide. Do not fill in.
TFT_DRIVER=
TFT_DTOVERLAY=
TFT_PINOUT=
DAC_CHIP=
DAC_BUS=
DAC_PINOUT=
BUTTON_PINOUT=
BATTERY_PINOUT=
