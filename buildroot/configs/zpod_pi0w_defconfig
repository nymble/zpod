# ZPOD (uGeek handheld, Raspberry Pi Zero W Rev 1.1, BCM2835 / ARMv6 hard-float)
# Buildroot fast-boot image (M6 test). Based on Buildroot 2026.02.3
# configs/raspberrypi0w_defconfig. Build: buildroot/build.sh (docs/BUILDROOT.md).
BR2_arm=y
BR2_arm1176jzf_s=y
BR2_ARM_EABIHF=y
BR2_ARM_FPU_VFPV2=y

# --- toolchain: built by Buildroot (works on x86_64 and arm64 build hosts;
# the Bootlin external toolchains are x86_64-host only). glibc, GCC 15, C++
# (MPD), kernel headers from the same RPi 6.12 kernel tarball as the kernel.
BR2_TOOLCHAIN_BUILDROOT=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_GCC_VERSION_15_X=y
BR2_GLOBAL_PATCH_DIR="board/raspberrypi/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_OPTIMIZE_2=y

# --- system: BusyBox init + mdev, read-only root, no getty on serial ---
BR2_TARGET_GENERIC_HOSTNAME="zpod"
BR2_TARGET_GENERIC_ISSUE="ZPOD (Buildroot fast-boot M6 test)"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
# BR2_TARGET_GENERIC_GETTY is not set
BR2_SYSTEM_DHCP=""
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="America/Los_Angeles"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_ZPOD_PATH)/board/zpod/users.table"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ZPOD_PATH)/board/zpod/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ZPOD_PATH)/board/zpod/post-build.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="$(BR2_EXTERNAL_ZPOD_PATH)/board/zpod/post-fakeroot.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_ZPOD_PATH)/board/zpod/post-image.sh"

# --- kernel: Raspberry Pi vendor tree as pinned by Buildroot 2026.02.3 (6.12.61) ---
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,21b410140c47ffab5668399f6f143c7d7b935c8b)/linux-21b410140c47ffab5668399f6f143c7d7b935c8b.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcmrpi"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ZPOD_PATH)/board/zpod/linux.fragment"
BR2_LINUX_KERNEL_LZ4=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2708-rpi-zero-w"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# --- firmware ---
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_BOOTCODE_BIN=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_ZPOD_PATH)/board/zpod/config.txt"
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_BT=y

# --- BusyBox ---
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ZPOD_PATH)/board/zpod/busybox.fragment"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y

# --- audio: ALSA + MPD (the music app talks to MPD) ---
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_ALSACTL=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
BR2_PACKAGE_MPD=y
BR2_PACKAGE_MPD_ALSA=y
BR2_PACKAGE_MPD_FLAC=y
BR2_PACKAGE_MPD_MPG123=y
BR2_PACKAGE_MPD_FAAD2=y
BR2_PACKAGE_MPD_VORBIS=y
BR2_PACKAGE_MPD_OPUS=y
BR2_PACKAGE_MPD_ID3TAG=y
BR2_PACKAGE_MPD_SQLITE=y
BR2_PACKAGE_MPD_TCP=y
# mpc: "mpc update" after an rsync-share upload (rsyncd.conf post-xfer exec)
BR2_PACKAGE_MPD_MPC=y

# --- python helpers shared with the pi-gen image (buttons, battery guard) ---
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON_EVDEV=y
BR2_PACKAGE_PYTHON_SMBUS2=y

# --- networking: Wi-Fi, USB gadget DHCP (BusyBox udhcpd), key-only SSH ---
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_GESFTPSERVER=y
BR2_PACKAGE_RSYNC=y
# Bluetooth: BlueZ (btmgmt + bluetoothctl for the Tools scanner), D-Bus for bluetoothd
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
# first login: sudo for the userconf.txt user (password) or key-only user (NOPASSWD)
BR2_PACKAGE_SUDO=y

# --- tools ---
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
# grow /data at first boot: sfdisk (resize p4 in the MBR) + partx (tell the kernel)
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_EXFATPROGS=y

# --- ZPOD packages (this BR2_EXTERNAL tree) ---
BR2_PACKAGE_ZPOD_DAC=y
BR2_PACKAGE_ZPOD_OVERLAYS=y
BR2_PACKAGE_ZPOD_APPS=y
BR2_PACKAGE_ZPOD_SCRIPTS=y

# --- images: squashfs root (LZ4: fast to decompress on one ARMv6 core) ---
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_LZ4=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_E2FSPROGS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_HOST_MTOOLS=y
