# ZPOD SD layout (MBR, 4 primaries):
#  p1 boot  FAT32 64M  firmware, kernel, dtb, overlays, config.txt, cmdline.txt
#                      (+ zpod-wifi.txt / zpod-ssh.pub drop-ins; mounted at /boot/firmware)
#  p2 rootA squashfs (LZ4, read-only), 256M partition
#  p3 rootB squashfs, 256M partition (A/B stub: same image as A, not booted yet)
#  p4 data  ext4 "zpoddata" 1G: /data (music, apps, ssh keys, Wi-Fi, state).
#           Growing it to the card size on first boot is a next step.
image boot.vfat {
	vfat {
		label = "ZPODBOOT"
		files = {
#BOOT_FILES#
		}
	}
	size = 64M
}

image data.ext4 {
	ext4 {
		label = "zpoddata"
		use-mke2fs = true
		features = "^metadata_csum_seed"
	}
	size = 1024M
}

image sdcard.img {
	hdimage {
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition rootA {
		partition-type = 0x83
		image = "rootfs.squashfs"
		size = 256M
	}

	partition rootB {
		partition-type = 0x83
		image = "rootfs.squashfs"
		size = 256M
	}

	partition data {
		partition-type = 0x83
		image = "data.ext4"
	}
}
