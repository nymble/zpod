#!/bin/sh
# Writable state on /data (p4), first-boot imports from the boot partition,
# device permissions for the unprivileged "zpod" app user.
case "$1" in
start)
	mountpoint -q /data || mount /data 2>/dev/null || {
		echo "zpod-data: /data not mounted; using tmpfs (nothing persists)"
		mount -t tmpfs -o mode=0755 tmpfs /data
	}
	mkdir -p /data/media/music /data/media/playlists /data/zpod/apps \
		/data/etc/dropbear /data/etc/ssh /data/var/mpd /data/var/zpod \
		/data/var/alsa /data/var/seedrng /data/log
	chown 1000:1000 /data/media /data/media/music /data/media/playlists
	chmod 700 /data/etc/ssh /data/etc/dropbear
	# Dropbear host keys persist on /data (/etc/dropbear -> /var/run/dropbear)
	ln -sfn /data/etc/dropbear /run/dropbear
	# Device nodes the apps (user zpod) need; mdev keeps hotplugged ones in line
	for d in /dev/spidev0.0 /dev/spidev0.1 /dev/gpiochip* /dev/gpiomem /dev/i2c-1; do
		[ -e "$d" ] && chgrp zpod "$d" && chmod 660 "$d"
	done
	mkdir -p /run/mpd
	# Bundled apps (music, clock, tetris): pre-seeded by post-image.sh; install
	# from /usr/share/zpod/packages if the data partition has none.
	if [ -z "$(ls /data/zpod/apps 2>/dev/null)" ]; then
		for a in /usr/share/zpod/packages/*.zpa; do
			[ -e "$a" ] && ZPOD_CORE_VERSION_FILE=/etc/zpod/core-version /usr/lib/zpod/bin/zpod-app install --force "$a"
		done
	fi
	# First boot: Wi-Fi and SSH keys from the FAT boot partition (files are deleted)
	/usr/lib/zpod/zpod-wifi-import-br
	/usr/lib/zpod/zpod-ssh-import-br
	;;
stop) sync ;;
esac
exit 0
