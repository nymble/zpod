#!/bin/sh
# Writable state on /data (p4; mounted and seeded by zpod-data-early in
# sysinit), first-boot imports from the boot partition (login user, SSH keys), device permissions for the "zpod" app user, and the background
# grow of /data to the end of the card.
case "$1" in
start)
	ip link set lo up 2>/dev/null
	# /data directories: zpod-data-early (sysinit)
	[ -s /data/etc/machine-id ] || { dbus-uuidgen > /data/etc/machine-id 2>/dev/null || cat /proc/sys/kernel/random/uuid | tr -d '-' > /data/etc/machine-id; }
	# Device nodes the apps (user zpod) need; mdev keeps hotplugged ones in line
	for d in /dev/spidev0.0 /dev/spidev0.1 /dev/gpiochip* /dev/gpiomem /dev/i2c-1; do
		[ -e "$d" ] && chgrp zpod "$d" && chmod 660 "$d"
	done
	mkdir -p /run/mpd
	# Bundled apps (music, clock, tetris): pre-seeded by post-image.sh; install
	# from /usr/share/zpod/packages if the data partition has none.
	if [ -z "$(ls /data/zpod/apps 2>/dev/null)" ]; then
		for a in /usr/share/zpod/packages/*.zpa; do
			[ -e "$a" ] && ZPOD_CORE_VERSION_FILE=/etc/zpod/core-version /usr/lib/zpod/bin/zpod-app install --force "$a"
		done
	fi
	# Login user + SSH keys from the FAT boot partition (normally already done
	# by zpod-data-early before the launcher; no-op then). zpod-wifi.txt: S40wifi
	/usr/lib/zpod/zpod-firstuser-br >>/data/log/firstuser.log 2>&1
	# /data grows to the end of the card (first boot only; online, background)
	( /usr/sbin/zpod-data-grow >>/data/log/data-grow.log 2>&1; /usr/sbin/zpod-bootmark data-grow-done ) </dev/null &
	;;
stop) sync ;;
esac
exit 0
