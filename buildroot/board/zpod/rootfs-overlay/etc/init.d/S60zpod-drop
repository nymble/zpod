#!/bin/sh
# zpod-drop HTTP upload server (port 8080; USB subnet trusted, Wi-Fi needs the
# token from /etc/zpod/drop.conf). Runs as the zpod user (uid 1000).
case "$1" in
start) start-stop-daemon -S -b -m -p /run/zpod/drop.pid -c zpod -x /usr/lib/zpod/bin/zpod-drop ;;
stop) start-stop-daemon -K -q -p /run/zpod/drop.pid ;;
restart) "$0" stop; "$0" start ;;
esac
exit 0
