#!/bin/sh
# zpod-drop: drop box web page + OPDS book catalog (port 8080). M6: OFF by
# default, like Pi OS. Tools > Drop box / Book catalog turn it on through the
# systemctl shim (flag /data/etc/zpod/drop.enabled). It reads dropbox=/opds=
# from /etc/zpod/drop.conf at start. USB (10.12.194.0/28) and the ZPOD hotspot
# (10.42.0.0/24) need no token; home Wi-Fi needs token= in drop.conf.
# Runs as uid/gid 1000 (the login user owns music, books and inbox), as on Pi OS.
PID=/run/zpod/drop.pid
FLAG=/data/etc/zpod/drop.enabled
case "$1" in
start)
	[ -e $FLAG ] || [ "$2" = force ] || exit 0
	start-stop-daemon -S -q -b -m -p $PID -c 1000:1000 -x /usr/lib/zpod/bin/zpod-drop ;;
stop) start-stop-daemon -K -q -p $PID; rm -f $PID ;;
restart) "$0" stop; sleep 0.3; "$0" start "$2" ;;
status) [ -f $PID ] && kill -0 "$(cat $PID)" 2>/dev/null; exit $? ;;
esac
exit 0
