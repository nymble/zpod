#!/bin/sh
# Wi-Fi in the background (never blocks the launcher): brcmfmac, wpa_supplicant
# on /data/etc/wpa_supplicant.conf, power save off, udhcpc, then ntpd
# (which writes the DS3231 via hwclock -w once synchronised).
CONF=/data/etc/wpa_supplicant.conf
start() {
	(
		modprobe -q brcmfmac
		i=0; while [ ! -e /sys/class/net/wlan0 ] && [ $i -lt 100 ]; do sleep 0.1; i=$((i+1)); done
		[ -e /sys/class/net/wlan0 ] || { echo "no wlan0"; exit 0; }
		/usr/sbin/zpod-bootmark wlan0-present
		grep -q '^network=' "$CONF" 2>/dev/null || { echo "no networks in $CONF"; exit 0; }
		rfkill unblock wlan 2>/dev/null
		ip link set wlan0 up
		wpa_supplicant -B -D nl80211 -i wlan0 -c "$CONF" -P /run/wpa_supplicant.pid
		iw dev wlan0 set power_save off 2>/dev/null
		udhcpc -b -S -i wlan0 -p /run/udhcpc.wlan0.pid -x hostname:zpod -s /usr/share/udhcpc/default.script
		i=0; while ! ip -4 addr show wlan0 | grep -q inet && [ $i -lt 300 ]; do sleep 0.1; i=$((i+1)); done
		ip -4 addr show wlan0 | grep -q inet && /usr/sbin/zpod-bootmark wlan0-ip
		ntpd -p pool.ntp.org -S /usr/lib/zpod/zpod-ntp-hook
	) </dev/null >>/run/zpod/wifi.log 2>&1 &
}
stop() {
	killall -q ntpd
	[ -f /run/udhcpc.wlan0.pid ] && kill "$(cat /run/udhcpc.wlan0.pid)" 2>/dev/null
	[ -f /run/wpa_supplicant.pid ] && kill "$(cat /run/wpa_supplicant.pid)" 2>/dev/null
}
case "$1" in start) start ;; stop) stop ;; restart) stop; start ;; esac
exit 0
