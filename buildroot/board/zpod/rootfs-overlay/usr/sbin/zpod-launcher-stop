#!/bin/sh
# Shutdown hook: the launcher draws "ZPOD off / Rebooting..." on SIGTERM.
# Our power menu writes /run/zpod/stop-kind itself; default is poweroff.
[ -s /run/zpod/stop-kind ] || echo poweroff > /run/zpod/stop-kind
killall -TERM zpod-launcher 2>/dev/null || exit 0
i=0; while pidof zpod-launcher >/dev/null && [ $i -lt 30 ]; do sleep 0.1; i=$((i+1)); done
exit 0
