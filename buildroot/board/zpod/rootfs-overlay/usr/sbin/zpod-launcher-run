#!/bin/sh
# Started (and respawned) by init. If the early instance (zpod-launcher-early)
# is still running, wait for it to exit first so only one launcher owns the LCD.
# Apps run as the "zpod" user.
while pidof zpod-launcher >/dev/null; do sleep 1; done
# A launcher from /data (zpod-core-overlay) that dies 4 times within 60 s is
# dropped for the image's own binary until the next "zpod-core-overlay apply".
L=/usr/lib/zpod/bin/zpod-launcher
if grep -q " $L " /proc/mounts; then
	now=$(cut -d. -f1 /proc/uptime)
	echo "$now" >> /run/zpod/launcher-starts
	n=0
	while read -r t; do [ $((now - t)) -lt 60 ] && n=$((n+1)); done < /run/zpod/launcher-starts
	if [ $n -ge 4 ]; then
		echo "zpod-launcher-run: /data launcher keeps exiting; using the image's launcher" >>/run/zpod/launcher.log
		umount -l "$L"; rm -f /run/zpod/launcher-starts
	fi
fi
export ZPOD_APP_USER=zpod ZPOD_DATA_DIR=/data/zpod/appdata HOME=/root PATH=/usr/sbin:/usr/bin:/sbin:/bin
exec /usr/lib/zpod/bin/zpod-launcher >>/run/zpod/launcher.log 2>&1
