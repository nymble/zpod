#!/bin/sh
# ZPOD first-boot SSH key import for the Buildroot image (dropbear, key-only).
# zpod-ssh.pub on the FAT boot partition (authorized_keys format, public keys
# only) is appended to /data/etc/ssh/authorized_keys, which is root's and the
# zpod user's ~/.ssh/authorized_keys, then deleted. Passwords are disabled
# (dropbear -s), so without a key there is no SSH login at all.
BOOT=${ZPOD_BOOT_DIR:-/boot/firmware}
PUB=$BOOT/zpod-ssh.pub
AK=/data/etc/ssh/authorized_keys
log() { echo "zpod-ssh-import: $*"; }
umask 077
mkdir -p /data/etc/ssh; touch "$AK"; chmod 600 "$AK"
[ -f "$PUB" ] || exit 0
if grep -q 'PRIVATE KEY' "$PUB"; then
	log "zpod-ssh.pub contains a PRIVATE key: ignored and deleted"; rm -f "$PUB"; exit 0
fi
added=0
tr -d '\r' < "$PUB" | grep -E '^(ssh-(ed25519|rsa)|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp256@openssh\.com) [A-Za-z0-9+/=]+( .*)?$' > /tmp/.zpod-keys
while IFS= read -r k; do
	grep -qxF "$k" "$AK" || { printf '%s\n' "$k" >> "$AK"; added=$((added + 1)); }
done < /tmp/.zpod-keys
rm -f /tmp/.zpod-keys "$PUB"; sync
log "installed $added new key(s); zpod-ssh.pub removed"
