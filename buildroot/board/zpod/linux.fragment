# ZPOD kernel config fragment on top of bcmrpi_defconfig (RPi 6.12.y vendor tree)
# --- root filesystem: squashfs built in, no initramfs ---
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=n
# --- display: userspace spidev (zpod-hal / mipidsi) + GPIO cdev for DC ---
CONFIG_SPI_BCM2835=y
CONFIG_SPI_SPIDEV=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_CDEV_V1=y
# Optional kernel DRM panel (not enabled in config.txt; the apps use spidev)
CONFIG_DRM_PANEL_MIPI_DBI=m
# fbtft is not used: the pi-gen image also drives the ILI9340 from userspace
# --- buttons: zpod-buttons (python) reads /dev/gpiomem and publishes uinput ---
CONFIG_INPUT_UINPUT=y
# /dev/gpiomem for zpod-buttons (built in: no wait for module coldplug)
CONFIG_RASPBERRYPI_GPIOMEM=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=m
# --- audio: bcm2835 I2S + in-tree PCM512x codec; machine driver = zpod-dac (OOT) ---
CONFIG_SND_BCM2835_SOC_I2S=m
CONFIG_SND_SOC_PCM512x=m
CONFIG_SND_SOC_PCM512x_I2C=m
# --- I2C: chardev for the MAX17048 gauge; DS3231 built in so hctosys sets the clock ---
CONFIG_I2C_BCM2835=y
CONFIG_I2C_CHARDEV=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_DRV_DS1307=y
CONFIG_BATTERY_MAX17040=m
# --- USB gadget: dwc2 + configfs CDC-NCM (ECM/RNDIS/ACM/mass storage available) ---
CONFIG_USB_DWC2=m
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=m
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_ETH=m
# --- Wi-Fi: brcmfmac as a module (firmware lives on the rootfs) ---
CONFIG_BRCMFMAC=m
CONFIG_CFG80211=y
CONFIG_RFKILL=y
# --- filesystems for music cards / USB sticks ---
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=m
# --- Bluetooth: BCM43430 on the PL011 UART via the hci_uart serdev driver ---
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_SERIAL_DEV_BUS=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_BCM=y
# --- boot-time trimming (M6): smaller zImage = less to load and unpack ---
# Debug/trace (KALLSYMS stayed selected through LATENCYTOP)
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_PROFILING is not set
# CONFIG_LATENCYTOP is not set
# CONFIG_KALLSYMS is not set
# CONFIG_KGDB is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_AUDIT is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_IKCONFIG is not set
# CONFIG_LOGO is not set
CONFIG_PRINTK_TIME=y
# Containers/security not used by a BusyBox handheld
# CONFIG_SCHED_AUTOGROUP is not set
# CONFIG_CGROUPS is not set
# CONFIG_SECURITY is not set
# CONFIG_ZSWAP is not set
# Network features not used (no NFS root, no firewall, no IPsec, no qdiscs)
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_NETFILTER is not set
# CONFIG_NET_SCHED is not set
# CONFIG_XFRM_USER is not set
# CONFIG_NET_KEY is not set
# CONFIG_INET_ESP is not set
# CONFIG_INET_IPCOMP is not set
# CONFIG_IP_PNP is not set
# File systems not used
# CONFIG_F2FS_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_NILFS2_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_REISERFS_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_CIFS is not set
# CONFIG_SMB_SERVER is not set
# The micro-USB data port is a gadget only (dwc2 dr_mode=peripheral): USB host,
# SCSI (USB storage) and HID become modules (not loaded on the ZPOD)
CONFIG_USB=m
CONFIG_SCSI=m
CONFIG_HID=m
# No camera/video/HDMI-DRM (the LCD is driven from userspace over spidev)
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_STAGING_MEDIA is not set
