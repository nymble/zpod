[Unit]
Description=ZPOD drop (HTTP music upload)
Documentation=https://github.com/nymble/zpod/blob/main/docs/FILE-TRANSFER.md
Requires=zpod-drop.socket
After=zpod-drop.socket

[Service]
Type=simple
ExecStart=/usr/lib/zpod/bin/zpod-drop
User=1000
Group=1000
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/zpod/media
