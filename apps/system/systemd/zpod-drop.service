[Unit]
Description=ZPOD drop box + OPDS book catalog (HTTP, port 8080)
Documentation=https://github.com/nymble/zpod/blob/main/docs/FILE-TRANSFER.md
Requires=zpod-drop.socket
# Never run as uid 1000 while first boot renames that user (usermod -l refuses).
After=zpod-drop.socket userconfig.service zpod-firstuser.service
After=srv-zpod-media.mount zpod-data-setup.service

[Service]
Type=simple
ExecStart=/usr/lib/zpod/bin/zpod-drop
User=1000
Group=1000
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# M6: music upload, drop box uploads (/data/inbox); /data/books is read-only here
ReadWritePaths=/srv/zpod/media -/data/inbox
